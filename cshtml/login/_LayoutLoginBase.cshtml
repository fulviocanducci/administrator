@{
    var pageTitle = ViewData["Title"] as string ?? "Acesso";
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var stylesCss = Url.Content("~/css/styles.css");
    var loginCss = Url.Content("~/css/login.css");
    var responsiveCss = Url.Content("~/css/login-responsive.css");
}
<!doctype html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f8fc">
    <title>@pageTitle · Nexo Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="@stylesCss?v=20261101" rel="stylesheet">
    <link href="@loginCss?v=20261101" rel="stylesheet">
    <link href="@responsiveCss?v=20261101" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body class="login-page @bodyClass">
    <main class="login-layout">
        <section class="login-story" aria-label="Sistema administrativo">
            <a class="brand login-brand" href="@Url.Content("~/index.html")"><span class="brand-mark"><i class="bi bi-grid-1x2-fill"></i></span><span>Nexo<span class="brand-light">Admin</span></span></a>
            @RenderSection("AuthStory", required: true)
            <span class="decor decor-one"></span><span class="decor decor-two"></span>
        </section>

        <section class="login-main" aria-label="Autenticação">
            <div class="login-main-top"><a class="mobile-brand" href="@Url.Content("~/index.html")"><span class="brand-mark"><i class="bi bi-grid-1x2-fill"></i></span>Nexo<span>Admin</span></a></div>
            @RenderBody()
        </section>
    </main>

    @RenderSection("Modals", required: false)
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.22.1/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
